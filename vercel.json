{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend"
    },
    "backend": {
      "root": "backend",
      "entrypoint": "src/server.js"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "service": "backend"
    },
    {
      "source": "/:path*",
      "service": "frontend"
    }
  ]
}
